{
  "name": "@zkmcp/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "MCP authorization gateway backed by Midnight zero-knowledge proofs",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/gateway.ts",
    "./approval": "./src/approval.ts",
    "./normalize": "./src/normalize.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "demo:gateway": "tsx src/demo-client.ts",
    "demo:upstream": "tsx src/demo-upstream.ts",
    "serve:demo": "tsx src/stdio.ts -- npx tsx src/demo-upstream.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@zkmcp/core": "*",
    "@zkmcp/midnight": "*",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
