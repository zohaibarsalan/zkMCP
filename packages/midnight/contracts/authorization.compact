pragma language_version >= 0.23;

import CompactStandardLibrary;

// A private authorization policy for the initial zkMCP tool classes. The
// policy itself never enters public ledger state; only its salted commitment
// is anchored on-chain.
export struct Policy {
    secret: Bytes<32>;
    allowedAgent: Bytes<32>;
    documentsTool: Bytes<32>;
    emailTool: Bytes<32>;
    paymentsTool: Bytes<32>;
    allowedResource: Bytes<32>;
    maxPaymentAmount: Uint<64>;
    paymentApprovalThreshold: Uint<64>;
}

// Public receipt material for an authorized action. A committed receipt means
// the private request satisfied the private policy bound to policyCommitment.
export struct AuthorizationReceipt {
    policyCommitment: Bytes<32>;
    executionCommitment: Bytes<32>;
    nullifier: Bytes<32>;
}

// The policy is supplied by local private state. Witness outputs are untrusted,
// so every authorize call recomputes the commitment and constrains it against
// the immutable commitment pinned at contract construction.
witness getPolicy(): Policy;

export sealed ledger policyCommitment: Bytes<32>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger lastExecutionCommitment: Bytes<32>;
export ledger lastNullifier: Bytes<32>;
export ledger authorizationCount: Counter;

// The random policy secret prevents low-entropy values such as limits or
// matter identifiers from being brute-forced from the public commitment.
export pure circuit hashPolicy(policy: Policy): Bytes<32> {
    return persistentHash<[
        Bytes<32>,
        Bytes<32>,
        Bytes<32>,
        Bytes<32>,
        Bytes<32>,
        Bytes<32>,
        Bytes<32>,
        Uint<64>,
        Uint<64>
    ]>([
        pad(32, "zkmcp:policy:v2"),
        policy.secret,
        policy.allowedAgent,
        policy.documentsTool,
        policy.emailTool,
        policy.paymentsTool,
        policy.allowedResource,
        policy.maxPaymentAmount,
        policy.paymentApprovalThreshold
    ]);
}

// Bind the private request to the committed policy. requestResource is used by
// resource-scoped tools and ignored by policy branches that do not need it.
pure circuit hashExecution(
    committedPolicy: Bytes<32>,
    requestAgent: Bytes<32>,
    requestTool: Bytes<32>,
    requestResource: Bytes<32>,
    requestAmount: Uint<64>,
    approved: Boolean,
    nonce: Bytes<32>
): Bytes<32> {
    return persistentHash<[
        Bytes<32>,
        Bytes<32>,
        Bytes<32>,
        Bytes<32>,
        Bytes<32>,
        Uint<64>,
        Boolean,
        Bytes<32>
    ]>([
        pad(32, "zkmcp:execution:v2"),
        committedPolicy,
        requestAgent,
        requestTool,
        requestResource,
        requestAmount,
        approved,
        nonce
    ]);
}

pure circuit hashNullifier(policySecret: Bytes<32>, nonce: Bytes<32>): Bytes<32> {
    return persistentHash<[Bytes<32>, Bytes<32>, Bytes<32>]>([
        pad(32, "zkmcp:nullifier:v1"),
        policySecret,
        nonce
    ]);
}

constructor() {
    const policy = getPolicy();
    assert(policy.maxPaymentAmount > 0, "Payment max amount must be greater than zero");
    assert(
        policy.paymentApprovalThreshold <= policy.maxPaymentAmount,
        "Payment approval threshold must not exceed max amount"
    );
    policyCommitment = disclose(hashPolicy(policy));
}

// Prove that one concrete agent action is authorized by the private policy.
// None of the request inputs are disclosed directly. The tool selects one of
// three private policy branches:
//   documents.read     -> resource membership
//   email.send         -> human approval
//   payments.transfer  -> private amount + approval threshold
export circuit authorize(
    requestAgent: Bytes<32>,
    requestTool: Bytes<32>,
    requestResource: Bytes<32>,
    requestAmount: Uint<64>,
    approved: Boolean,
    nonce: Bytes<32>
): AuthorizationReceipt {
    const policy = getPolicy();
    const computedPolicyCommitment = hashPolicy(policy);

    assert(
        computedPolicyCommitment == policyCommitment,
        "Private policy does not match committed policy"
    );
    assert(requestAgent == policy.allowedAgent, "Agent is not authorized by policy");

    const isDocumentsRead = requestTool == policy.documentsTool;
    const isEmailSend = requestTool == policy.emailTool;
    const isPaymentTransfer = requestTool == policy.paymentsTool;

    assert(
        isDocumentsRead || isEmailSend || isPaymentTransfer,
        "Tool is not authorized by policy"
    );

    if (isDocumentsRead) {
        assert(
            requestResource == policy.allowedResource,
            "Resource is not authorized by private policy"
        );
    }

    if (isEmailSend) {
        assert(approved, "Human approval required by private email policy");
    }

    if (isPaymentTransfer) {
        assert(
            requestAmount <= policy.maxPaymentAmount,
            "Amount exceeds private payment limit"
        );
        assert(
            requestAmount <= policy.paymentApprovalThreshold || approved,
            "Human approval required by private payment policy"
        );
    }

    const executionCommitment = hashExecution(
        computedPolicyCommitment,
        requestAgent,
        requestTool,
        requestResource,
        requestAmount,
        approved,
        nonce
    );
    const nullifier = hashNullifier(policy.secret, nonce);

    const publicExecutionCommitment = disclose(executionCommitment);
    const publicNullifier = disclose(nullifier);

    assert(
        !usedNullifiers.member(publicNullifier),
        "Authorization nonce has already been used"
    );
    usedNullifiers.insert(publicNullifier);
    lastExecutionCommitment = publicExecutionCommitment;
    lastNullifier = publicNullifier;
    authorizationCount += 1;

    return AuthorizationReceipt {
        policyCommitment: policyCommitment,
        executionCommitment: publicExecutionCommitment,
        nullifier: publicNullifier
    };
}
