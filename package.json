{
  "name": "zkmcp",
  "version": "0.1.0",
  "private": true,
  "description": "A zero-knowledge authorization layer for AI agents and MCP tools",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "ultracite check",
    "compile:contracts": "npm run compile --workspace=@zkmcp/midnight",
    "fix": "ultracite fix",
    "foundation:check": "npm run check && npm run typecheck",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@zkmcp/midnight",
    "typecheck": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "ultracite": "^7.10.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
